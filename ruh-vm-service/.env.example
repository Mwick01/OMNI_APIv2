# Shared secret: put the same value in the Pi's PI_API_TOKEN.
PI_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALLOWED_PI_DEVICES=ruh-pi-zero-w

API_HOST=127.0.0.1
API_PORT=8100
MAX_UPLOAD_MB=25

OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4.1-nano
PROCESS_BATCH_SIZE=2
MAX_ANALYSIS_ATTEMPTS=5
PROCESSING_STALE_MINUTES=30

GREEN_API_INSTANCE=REPLACE_ME
GREEN_API_TOKEN=REPLACE_ME
WHATSAPP_GROUP_IDS=group1@g.us,group2@g.us
DELIVERY_BATCH_SIZE=10
MAX_DELIVERY_ATTEMPTS=30
DELIVERY_STALE_MINUTES=15
SEND_DELAY_SECONDS=2

# Optional path overrides
# DATA_DIR=/home/YOUR_USER/ruh-vm-service/data
# DB_PATH=/home/YOUR_USER/ruh-vm-service/data/database.db
