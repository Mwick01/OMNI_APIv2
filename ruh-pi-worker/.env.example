# FOSMIS credentials — fill locally on the Pi and never commit .env
SITE_USERNAME=
SITE_PASSWORD=

LOGIN_URL_PURPLE=https://paravi.ruh.ac.lk/fosmis/login.php
NOTICE_URL_PURPLE=https://paravi.ruh.ac.lk/fosmis/forms/form_53_a.php

# First successful run: queue notices from the last N hours.
# Older visible rows are stored as baseline_ignored, so they will not be sent.
INITIAL_LOOKBACK_HOURS=24
BOOTSTRAP_UNDATED_LIMIT=5
SCAN_ROW_LIMIT=200
SCAN_OVERLAP_HOURS=24
EARLY_STOP_OLD_ROWS=10
SESSION_MAX_AGE_MINS=60

DOWNLOAD_BATCH_SIZE=20
UPLOAD_BATCH_SIZE=10
MAX_FILE_MB=25
VERIFY_FILE_HASH_BEFORE_UPLOAD=true

CONNECT_TIMEOUT_SECONDS=20
READ_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=120

# Leave these blank until the GCP receiver is ready.
VM_INGEST_URL=
PI_API_TOKEN=
PI_DEVICE_ID=ruh-pi-zero-w
